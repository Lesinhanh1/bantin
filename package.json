{
  "name": "bantin",
  "version": "0.1.0",
  "private": true,
  "description": "Trợ lý tin tức cá nhân chạy trên Cloudflare Workers (miễn phí)",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute bantin --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute bantin --local --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
